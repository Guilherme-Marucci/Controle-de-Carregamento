# ==============================================================================
# CARGA3D - CONTROLE DE CARREGAMENTO & DISTRIBUIÇÃO 3D
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env-example)
# NUNCA insira senhas, chaves reais ou segredos de produção neste arquivo.
# ==============================================================================

# Configuração do Servidor Local
PORT=5173
HOST=127.0.0.1
NODE_ENV=development

# Configurações de Sessão e Autenticação Local
SESSION_SECRET=dev-carga3d-local-session-secret-change-in-production
COOKIE_NAME=c3d_session

# Banco de Dados Local (Cloudflare D1 / SQLite)
DATABASE_NAME=site-creator-d1
WRANGLER_PERSIST_TO=.wrangler/state

# Telemetria e Logs (desabilitados por padrão em ambiente local)
WRANGLER_SEND_METRICS=false
WRANGLER_WRITE_LOGS=false
